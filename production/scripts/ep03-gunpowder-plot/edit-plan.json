   "section": "s01",
   "slot": "pre",
   "kind": "rustle",
   "start_ms": 0,
   "end_ms": 6000,
   "dur_ms": 6000,
   "description": "Cold open on the folds of the anonymous letter. A hand smooths it flat and the eyes follow the page down. Paper rustle only, no narration yet."
  },
  {
   "section": "s01",
   "slot": "post",
   "kind": "title",
   "start_ms": 40371,
   "end_ms": 44660,
   "dur_ms": 4289,
   "description": "Series title card over the letter: The Gunpowder Plot. The letter has no signature, so none is drawn."
  },
  {
   "section": "s02",
   "slot": "pre",
   "kind": "card",
   "start_ms": 45000,
   "end_ms": 48000,
   "dur_ms": 3000,
