   "slot": "pre",
   "kind": "scene",
   "start_ms": 223000,
   "end_ms": 225000,
   "dur_ms": 2000,
   "description": "Hoxton at supper time: the footman receives the folded sheet. The sender stays out of view."
  },
  {
