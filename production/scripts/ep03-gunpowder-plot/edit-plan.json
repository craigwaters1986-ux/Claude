   "slot": "pre",
   "kind": "map",
   "start_ms": 48000,
   "end_ms": 51500,
   "dur_ms": 3500,
   "description": "Pull back from the page to a map of Scotland and England before the narrator returns."
  },
  {
   "section": "s02",
   "slot": "after group 2",
   "kind": "doc",
   "start_ms": 72900,
   "end_ms": 75400,
   "dur_ms": 2500,
   "description": "Hold on the map: one crown over Edinburgh, a second over London, one king between them."
  },
  {
   "section": "s02",
   "slot": "post",
   "kind": "scene",
   "start_ms": 118484,
   "end_ms": 124660,
   "dur_ms": 6176,
   "description": "Move into the parish street as the church bell sounds. The bell, not the camera, sets the family’s pace."
  },
  {
   "section": "s03",
   "slot": "pre",
   "kind": "card",
   "start_ms": 125000,
   "end_ms": 128000,
   "dur_ms": 3000,
   "description": "Chapter card."
  },
  {
   "section": "s03",
   "slot": "pre",
   "kind": "scene",
   "start_ms": 128000,
   "end_ms": 130500,
   "dur_ms": 2500,
   "description": "Robert Catesby alone in a Warwickshire room, labelled at first appearance."
  },
  {
   "section": "s03",
   "slot": "after group 5",
   "kind": "scene",
   "start_ms": 152234,
   "end_ms": 155734,
   "dur_ms": 3500,
   "description": "London, May 1604: the four other men arrive one at a time; Guy Fawkes gets his own shot."
  },
  {
   "section": "s03",
   "slot": "after group 6",
   "kind": "scene",
   "start_ms": 178257,
   "end_ms": 182757,
   "dur_ms": 4500,
   "description": "Old Palace of Westminster, interior, as the State Opening would look: benches filling, no one in danger on screen."
  },
  {
   "section": "s03",
   "slot": "after group 7",
   "kind": "scene",
   "start_ms": 204273,
   "end_ms": 207273,
   "dur_ms": 3000,
   "description": "Princess Elizabeth’s portrait settles beside the Midlands map; the road markers where support was hoped for stay empty."
  },
  {
   "section": "s03",
   "slot": "post",
   "kind": "scene",
   "start_ms": 214687,
   "end_ms": 219660,
   "dur_ms": 4973,
   "description": "Empty Midlands roads at dusk. The expected rising does not come."
  },
  {
   "section": "s04",
   "slot": "pre",
   "kind": "card",
   "start_ms": 220000,
   "end_ms": 223000,
   "dur_ms": 3000,
   "description": "Chapter card."
  },
  {
