{
  "name": "forma-gym",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Forma — premium AI gym tracker: web prototype, AI server and native iOS/watchOS sources",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.js",
    "test:server": "node --test --import tsx server/test/*.test.ts",
    "test:swift": "cd ios/GymCore && swift test",
    "server": "tsx server/src/index.ts",
    "test:e2e": "node tests/e2e/flows.cjs",
    "test:sync": "node tests/e2e/sync.cjs",
    "rep-eval": "node tools/rep-eval.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "pg": "^8.23.1",
    "three": "0.160.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "meshoptimizer": "^1.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
